{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hardikashah-eng/earnest-agent-pay/spec/decision.schema.json",
  "title": "Decision",
  "description": "The gateway's answer to a spend request.",
  "type": "object",
  "required": ["request_id", "status", "reasons", "tier"],
  "properties": {
    "request_id": { "type": "string" },
    "status": { "type": "string", "enum": ["approved", "denied", "escalated"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "tier": { "type": "string", "enum": ["restricted", "new", "established", "trusted"] },
    "credential": {
      "type": "object",
      "description": "Present only when approved. A scoped, expiring payment credential.",
      "required": ["id", "cap", "currency", "expires_at", "single_use"],
      "properties": {
        "id": { "type": "string" },
        "cap": { "type": "number" },
        "currency": { "type": "string" },
        "merchant_lock": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "single_use": { "type": "boolean" },
        "backend": { "type": "string" }
      }
    },
    "confidence": {
      "type": "object",
      "description": "Merchant trust and purchase-history signals (SPEC.md sections 3a, 3b). Informational; the decision is in status and reasons.",
      "required": ["level", "score", "merchant", "history", "signals"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "merchant": {
          "type": "object",
          "required": ["merchant", "status", "reasons"],
          "properties": {
            "merchant": { "type": "string" },
            "status": { "type": "string", "enum": ["verified", "user_trusted", "unknown", "suspicious", "untrusted"] },
            "merchant_id": { "type": "string" },
            "name": { "type": "string" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "merchant_purchases": { "type": "integer" },
            "from_statements": { "type": "integer" },
            "same_item": { "type": "integer" },
            "similar_item": { "type": "integer" },
            "rejected_before": { "type": "integer" },
            "last_purchase": { "type": "string", "format": "date" },
            "typical_amount": { "type": "number" },
            "item_typical_amount": { "type": "number" }
          }
        },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
