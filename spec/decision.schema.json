{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hardikashah-eng/earnest-agent-pay/spec/decision.schema.json",
  "title": "Decision",
  "description": "The gateway's answer to a spend request.",
  "type": "object",
  "required": ["request_id", "status", "reasons", "tier"],
  "properties": {
    "request_id": { "type": "string" },
    "status": {
      "type": "string", "enum": ["approved", "denied", "escalated", "shadow"],
      "description": "shadow: the agent is in read-only shadow mode (SPEC.md 3j); `shadow.would_be` is the real decision and nothing is paid."
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "tier": { "type": "string", "enum": ["restricted", "new", "established", "trusted"] },
    "credential": {
      "type": "object",
      "description": "Present only when approved. A scoped, expiring payment credential.",
      "required": ["id", "cap", "currency", "expires_at", "single_use"],
      "properties": {
        "id": { "type": "string" },
        "cap": { "type": "number" },
        "currency": { "type": "string" },
        "merchant_lock": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "single_use": { "type": "boolean" },
        "backend": { "type": "string" },
        "item_lock": { "type": "string", "description": "The item the agent claimed. When the merchant sends cart line items, the card only pays for this item (SPEC.md 3d)." },
        "account": { "type": "string", "description": "The agent account (user:agent) the card is drawn from (SPEC.md 3i)." }
      }
    },
    "payment": {
      "type": "object",
      "description": "Present when an approved purchase is paid from an agent account (SPEC.md 3i).",
      "required": ["method", "funding_id", "pay_with", "amount", "remaining"],
      "properties": {
        "method": { "type": "string", "enum": ["allowance", "gift_card", "prepaid"] },
        "funding_id": { "type": "string" },
        "pay_with": { "type": "string", "description": "Plain-language source, e.g. 'target.com gift card ending 4417'. Never a card number or code." },
        "amount": { "type": "number" },
        "remaining": { "type": "number", "description": "What's left on that source after this purchase." },
        "note": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "description": "The agent's value estimate scored on the user's rubric (SPEC.md 3l). `missing: true` when the gate is on and none was given.",
      "properties": {
        "total": { "type": ["number", "null"], "description": "Weighted score, 1-10." },
        "threshold": { "type": "number" },
        "passes": { "type": "boolean" },
        "coverage": { "type": "number", "description": "Share of the weights backed by inputs, 0-1." },
        "net_value": { "type": ["number", "null"], "description": "One year: hours saved x hourly value + added value - price." },
        "scores": { "type": "object", "description": "price, time_saved, utility, added_value: 1-10 or null." },
        "missing": { "type": "boolean" }
      }
    },
    "shadow": {
      "type": "object",
      "description": "Present when status is shadow (SPEC.md 3j).",
      "required": ["would_be", "card"],
      "properties": {
        "would_be": { "type": "string", "enum": ["approved", "denied", "escalated"] },
        "card": { "type": "string", "description": "The card the agent is learning from." },
        "violation": { "type": "boolean", "description": "Whether the would-be decision was a violation. Shadow mode never scores it." }
      }
    },
    "confidence": {
      "type": "object",
      "description": "Purchase confidence (SPEC.md sections 3a-3c). Low scores and routine repeats affect the decision; the reasons say how.",
      "required": ["level", "score", "factors", "merchant", "history", "signals"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "factors": {
          "type": "object",
          "description": "Each 0-1 with a plain-language why.",
          "properties": {
            "authenticity": { "$ref": "#/$defs/factor" },
            "price": { "$ref": "#/$defs/factor" },
            "familiarity": { "$ref": "#/$defs/factor" },
            "budget": { "$ref": "#/$defs/factor" }
          }
        },
        "weights": { "type": "object", "additionalProperties": { "type": "number" } },
        "merchant": {
          "type": "object",
          "required": ["merchant", "status", "reasons"],
          "properties": {
            "merchant": { "type": "string" },
            "status": { "type": "string", "enum": ["verified", "user_trusted", "unknown", "suspicious", "untrusted"] },
            "merchant_id": { "type": "string" },
            "name": { "type": "string" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "merchant_purchases": { "type": "integer" },
            "from_statements": { "type": "integer" },
            "from_orders": { "type": "integer" },
            "same_item": { "type": "integer" },
            "similar_item": { "type": "integer" },
            "same_item_elsewhere": { "type": "integer" },
            "rejected_before": { "type": "integer" },
            "last_purchase": { "type": "string", "format": "date" },
            "last_same_item": { "type": "string", "format": "date" },
            "typical_amount": { "type": "number" },
            "same_item_price_range": { "type": "array", "items": { "type": "number" } },
            "similar_item_price_range": { "type": "array", "items": { "type": "number" } },
            "interest": { "type": "object" },
            "memberships": { "type": "array", "items": { "type": "string" } }
          }
        },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "factor": {
      "type": "object",
      "required": ["score", "why"],
      "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "why": { "type": "string" } }
    }
  }
}
