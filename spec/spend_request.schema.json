{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hardikashah-eng/earnest-agent-pay/spec/spend_request.schema.json",
  "title": "SpendRequest",
  "description": "What an agent sends when it wants to spend.",
  "type": "object",
  "required": ["agent_id", "mandate_id", "amount", "merchant", "category", "reason"],
  "properties": {
    "agent_id": { "type": "string" },
    "mandate_id": { "type": "string" },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "merchant": { "type": "string" },
    "category": { "type": "string" },
    "reason": { "type": "string", "description": "Why this purchase serves the mandate." },
    "recurring": { "type": "boolean", "default": false, "description": "True for subscriptions." },
    "international": { "type": "boolean", "default": false },
    "ask_first": {
      "type": "boolean", "default": false,
      "description": "The agent is unsure and asks for approval before acting. Rewarded."
    },
    "item": {
      "type": "string",
      "description": "What is being bought (e.g. 'AA batteries, 24 pack'). Optional; lets the gateway match the user's past purchases, order history and interests."
    },
    "product_id": {
      "type": "string",
      "description": "ASIN, UPC/EAN/GTIN (check digit verified) or sku:<retailer>:<id>. When known on both sides, decides 'same item' for history and checkout checks."
    },
    "quantity": {
      "type": "integer", "minimum": 1, "default": 1,
      "description": "Units covered by amount, so prices are compared per unit."
    },
    "evaluation": {
      "type": "object",
      "description": "The agent's value estimate, scored on the user's rubric (SPEC.md 3l).",
      "properties": {
        "lifespan_months": { "type": "number", "minimum": 0 },
        "uses_per_month": { "type": "number", "minimum": 0 },
        "total_uses": { "type": "number", "minimum": 0, "description": "Instead of lifespan x uses per month." },
        "hours_saved_per_year": { "type": "number", "minimum": 0 },
        "solves": { "type": "number", "minimum": 1, "maximum": 10, "description": "How well it solves a specific problem." },
        "core": { "type": "boolean", "description": "A core, frequent function rather than a nice-to-have." },
        "benefits": {
          "type": "object",
          "properties": {
            "stress": { "type": "number", "minimum": 0, "maximum": 3 }, "health": { "type": "number", "minimum": 0, "maximum": 3 },
            "skill": { "type": "number", "minimum": 0, "maximum": 3 }, "social": { "type": "number", "minimum": 0, "maximum": 3 },
            "comfort": { "type": "number", "minimum": 0, "maximum": 3 }
          },
          "additionalProperties": false
        },
        "resale_value": { "type": "number", "minimum": 0 },
        "added_value_usd": { "type": "number", "minimum": 0 },
        "scores": {
          "type": "object", "description": "Direct 1-10 scores; beat the inputs for that metric.",
          "properties": {
            "price": { "type": "number", "minimum": 1, "maximum": 10 }, "time_saved": { "type": "number", "minimum": 1, "maximum": 10 },
            "utility": { "type": "number", "minimum": 1, "maximum": 10 }, "added_value": { "type": "number", "minimum": 1, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "note": { "type": "string", "maxLength": 300 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
